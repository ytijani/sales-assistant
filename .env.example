# Database connection for the read-only agent
AGENT_DATABASE_URL=postgresql+asyncpg://readonly_agent_role:changeme@localhost:5432/pos

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key
# Model options: llama-3.3-70b-versatile (recommended), llama-3.1-8b-instant, qwen/qwen-2.5-coder-32b, openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile

# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_key_from_smith.langchain.com
LANGSMITH_PROJECT=sales-assistant
